# Build context is a package_headless.dart output directory, never the checkout
# or an installation. Build on the same Linux architecture as these binaries.
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

LABEL io.universe-builder-mcp.project="universe-builder-mcp" \
      io.universe-builder-mcp.purpose="headless-service"

# System trust roots are required for verified PostgreSQL TLS connections.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates libsecret-1-0 \
    && find /var/lib/apt/lists -mindepth 1 -delete \
    && mkdir -p /data /opt/universe-builder \
    && chown 10001:10001 /data \
    && chmod 0700 /data

COPY bin/ /opt/universe-builder/bin/
COPY lib/ /opt/universe-builder/lib/
COPY release-manifest.json /opt/universe-builder/release-manifest.json

ENV PATH="/opt/universe-builder/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
USER 10001:10001
WORKDIR /data
STOPSIGNAL SIGTERM
ENTRYPOINT ["/opt/universe-builder/bin/universe-engine"]
CMD ["--installation", "/data/installation", "--http-only"]
